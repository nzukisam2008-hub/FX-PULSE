# ============================================================
# FX Pulse — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file to GitHub — it's in .gitignore.
#
#   cp .env.example .env
#
# ============================================================

# ------------------------------------------------------------
# Database (SQLite — local file, no credentials needed)
# ------------------------------------------------------------
DATABASE_URL=file:./db/custom.db

# ------------------------------------------------------------
# Z-AI Vision API (for D-Analysis screenshot analysis)
# ------------------------------------------------------------
# Get your API key from https://z.ai
# Only required if deploying outside the Z.ai sandbox.
# In the sandbox, the SDK is pre-configured automatically.
#
# ZAI_API_KEY=your_zai_api_key_here

# ------------------------------------------------------------
# Optional: TradingView (not required — public widgets)
# ------------------------------------------------------------
# TradingView widgets are public and need no API key.
# If you want to use TradingView's REST API (not widgets),
# sign up at https://www.tradingview.com/broker-integration/
#
# TRADINGVIEW_API_KEY=your_tradingview_api_key_here

# ------------------------------------------------------------
# Optional: Forex Factory (not required — public JSON feed)
# ------------------------------------------------------------
# The FF calendar feed at nfs.faireconomy.media is public.
# No API key needed. Rate-limited to ~1 request/minute.
# If you hit rate limits, consider self-hosting the feed.

# ------------------------------------------------------------
# Optional: MyFXBook (not required — public JS widget)
# ------------------------------------------------------------
# MyFXBook's community outlook widget is public.
# For the MyFXBook REST API (account stats, etc.):
# https://www.myfxbook.com/api
#
# MYFXBOOK_EMAIL=your_email@example.com
# MYFXBOOK_PASSWORD=your_myfxbook_password
# MYFXBOOK_SESSION=your_session_token

# ------------------------------------------------------------
# Optional: FXBlue (not required — uses TradingView fallback)
# ------------------------------------------------------------
# FXBlue blocks third-party iframes. The dashboard uses
# TradingView's forex heat map as a live fallback.
# For FXBlue's API (if you have an account):
# https://www.fxblue.com/api
#
# FXBLUE_API_KEY=your_fxblue_api_key_here
